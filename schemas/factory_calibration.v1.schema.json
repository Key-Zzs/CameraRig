{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://key-zzs.github.io/CameraRig/schemas/factory_calibration.v1.schema.json",
  "title": "CameraRig factory calibration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "device",
    "active_stream_profiles",
    "intrinsics",
    "internal_transforms",
    "depth_scale_m_per_unit",
    "quality",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "camera-rig.factory-calibration.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "device": {"$ref": "#/$defs/device"},
    "active_stream_profiles": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/stream_profile"},
      "minProperties": 1
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/intrinsics"},
      "minProperties": 1
    },
    "internal_transforms": {
      "type": "array",
      "items": {"$ref": "#/$defs/rigid_transform"}
    },
    "depth_scale_m_per_unit": {"type": "number", "exclusiveMinimum": 0},
    "quality": {"$ref": "#/$defs/quality"},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "camera_name",
        "expected_model",
        "reported_model",
        "serial",
        "canonical_model",
        "product_id",
        "product_line",
        "physical_port",
        "firmware_version",
        "sdk_version",
        "usb_type",
        "metadata"
      ],
      "properties": {
        "driver": {"type": "string", "minLength": 1},
        "camera_name": {"type": "string", "minLength": 1},
        "expected_model": {"type": "string", "minLength": 1},
        "reported_model": {"type": "string", "minLength": 1},
        "serial": {"type": "string", "minLength": 1},
        "canonical_model": {"type": ["string", "null"]},
        "product_id": {"type": ["string", "null"]},
        "product_line": {"type": ["string", "null"]},
        "physical_port": {"type": ["string", "null"]},
        "firmware_version": {"type": ["string", "null"]},
        "sdk_version": {"type": ["string", "null"]},
        "usb_type": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    },
    "stream_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_name",
        "width",
        "height",
        "fps",
        "format",
        "index",
        "sensor_identifier"
      ],
      "properties": {
        "stream_name": {"enum": ["color", "depth", "ir_left", "ir_right"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "minLength": 1},
        "index": {"type": ["integer", "null"], "minimum": 0},
        "sensor_identifier": {"type": ["string", "null"]}
      }
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "width",
        "height",
        "fx",
        "fy",
        "cx",
        "cy",
        "distortion_model",
        "distortion_coeffs"
      ],
      "properties": {
        "frame": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fx": {"type": "number", "exclusiveMinimum": 0},
        "fy": {"type": "number", "exclusiveMinimum": 0},
        "cx": {"type": "number", "minimum": 0},
        "cy": {"type": "number", "minimum": 0},
        "distortion_model": {"type": "string", "minLength": 1},
        "distortion_coeffs": {"type": "array", "items": {"type": "number"}}
      }
    },
    "rigid_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_frame", "target_frame", "matrix"],
      "properties": {
        "source_frame": {"type": "string", "minLength": 1},
        "target_frame": {"type": "string", "minLength": 1},
        "matrix": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number"}
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "metrics", "thresholds", "warnings", "failure_reasons"],
      "properties": {
        "passed": {"const": true},
        "metrics": {"type": "object"},
        "thresholds": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "failure_reasons": {"type": "array", "maxItems": 0}
      }
    }
  }
}
