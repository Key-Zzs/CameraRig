{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://key-zzs.github.io/CameraRig/schemas/capture_manifest.v1.schema.json",
  "title": "CameraRig capture artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_at",
    "camera",
    "serial",
    "capture_configuration",
    "factory_calibration",
    "frame_count",
    "frames",
    "global_preview_paths",
    "quality",
    "provenance",
    "checksums",
    "preview_notice"
  ],
  "properties": {
    "schema_version": {"const": "camera-rig.capture.v1"},
    "artifact_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "camera": {"type": "string", "minLength": 1},
    "serial": {"type": "string", "minLength": 1},
    "capture_configuration": {"type": "object"},
    "factory_calibration": {"type": "string", "minLength": 1},
    "frame_count": {"type": "integer", "minimum": 1},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "data_path", "metadata_path", "preview_paths"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "data_path": {"type": "string", "minLength": 1},
          "metadata_path": {"type": "string", "minLength": 1},
          "preview_paths": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {"type": "string", "minLength": 1},
              "depth": {"type": "string", "minLength": 1},
              "ir_left": {"type": "string", "minLength": 1},
              "ir_right": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "global_preview_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "validated_frame_count"],
      "properties": {
        "passed": {"type": "boolean"},
        "validated_frame_count": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {"type": "object"},
    "checksums": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "preview_notice": {"const": "PNG files are derived diagnostics and are never replay data"}
  }
}
